// This file REQUIRES the following external definitions:
// FILE_NAME, VER_MAJOR, VER_MINOR, VER_BUILD, VER_PRIVATE, and VER_STRING

#include <Winver.h>
#include "common/ov_plugin_ver.h"

#if defined(DEBUG) || defined(_DEBUG)
#define VER_DEBUG VS_FF_DEBUG
#else
#define VER_DEBUG 0
#endif

// -----------------------------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OVEP_PLUGIN_MAJOR_VERSION, OVEP_PLUGIN_MINOR_VERSION, OVEP_PLUGIN_PATCH_VERSION, 0
PRODUCTVERSION  OVEP_PLUGIN_MAJOR_VERSION, OVEP_PLUGIN_MINOR_VERSION, OVEP_PLUGIN_PATCH_VERSION, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       VER_DEBUG
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN

BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Intel Corporation"
            VALUE "FileDescription",  "ONNX Runtime OpenVINO Provider"
            VALUE "FileVersion",      OVEP_PLUGIN_VER_TAGGED
            VALUE "InternalName",     "ONNX Runtime OpenVINO Provider"
            VALUE "LegalCopyright",   "\251 Intel Corporation"
            VALUE "OriginalFilename", FILE_NAME
            VALUE "ProductName",      "ONNX Runtime OpenVINO Provider"
            VALUE "ProductVersion",   OVEP_PLUGIN_VER_TAGGED
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END

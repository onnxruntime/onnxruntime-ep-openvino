#pragma once

#define OVEP_PLUGIN_MAJOR_VERSION @OVEP_PLUGIN_MAJOR_VERSION@
#define OVEP_PLUGIN_MINOR_VERSION @OVEP_PLUGIN_MINOR_VERSION@
#define OVEP_PLUGIN_PATCH_VERSION @OVEP_PLUGIN_PATCH_VERSION@

#define OVEP_PLUGIN_MAJOR_VERSION_STR "@OVEP_PLUGIN_MAJOR_VERSION@"
#define OVEP_PLUGIN_MINOR_VERSION_STR "@OVEP_PLUGIN_MINOR_VERSION@"
#define OVEP_PLUGIN_PATCH_VERSION_STR "@OVEP_PLUGIN_PATCH_VERSION@"

#ifndef PRODUCTION
#define OVEP_PLUGIN_PATCH_VERSION_SUFFIX_STR "-dev"
#else
#define OVEP_PLUGIN_PATCH_VERSION_SUFFIX_STR ""
#endif  // PRODUCTION

#define OVEP_PLUGIN_VERSION OVEP_PLUGIN_MAJOR_VERSION_STR "." OVEP_PLUGIN_MINOR_VERSION_STR "." OVEP_PLUGIN_PATCH_VERSION_STR OVEP_PLUGIN_PATCH_VERSION_SUFFIX_STR

// Optional CI build metadata (build type + build number), e.g. ".ci.4567".
// Populated by the build system; empty for local/dev builds.
#ifndef OVEP_PLUGIN_BUILD_METADATA
#define OVEP_PLUGIN_BUILD_METADATA ""
#endif

#define OVEP_PLUGIN_VER_TAGGED OVEP_PLUGIN_VERSION "+" GIT_COMMIT_ID OVEP_PLUGIN_BUILD_METADATA
